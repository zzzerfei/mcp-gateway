# ─────────────────────────────────────────────────────────────
# MCP 网关后端环境变量模板
# 优先级：环境变量 > config/gateway.json > 内置默认
#
# 注意：后端直接读取「进程环境变量」，自身不内置 dotenv。本地开发推荐使用仓库根 start.sh：
#   ./start.sh      →  自动在当前 shell 里 source backend/.env，一行启前后端
# 不依赖 start.sh 的三种手动喂入方式，任选其一：
#   1) 本地开发： cp .env.example .env && set -a && source .env && set +a && npm run start:dev
#   2) systemd  ： 服务单元里 EnvironmentFile=/etc/mcp-gateway.env（直接兼容本格式）
#   3) Docker   ： docker run --env-file .env，或 compose 的 env_file:
# 生产用 secret 管理，勿提交真实值。
# ─────────────────────────────────────────────────────────────

# ── 监听 ──
MGW_PORT=8080
MGW_HOST=127.0.0.1
# 对外基址（启动日志展示 + MCP Origin 校验白名单）
MGW_PUBLIC_ORIGIN=http://127.0.0.1:8080
# 允许的浏览器 Origin，逗号分隔（防 DNS rebinding）。
# 留空：开发态放开跨域；生产（NODE_ENV=production）关闭跨域，仅允许显式白名单
MGW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 数据 ──
# SQLite 与备份目录（相对 backend/ 或绝对路径）
MGW_DATA_DIR=./data
# 中间层配置文件路径
MGW_CONFIG=./config/gateway.json
# 实体自动建表：默认开(MVP 零迁移上手)。生产建议置 0 并改用 migrations
MGW_DB_SYNCHRONIZE=1

# ── 安全（生产必填）──
# AES-256-GCM 主密钥，64 位 hex：openssl rand -hex 32
# 变更此值将导致历史加密的上游凭据无法解密，需重新录入！
# 生产（NODE_ENV=production）下未配置会直接拒绝启动，避免用公开兜底密钥加密凭据
MGW_SECRET=
# 亦可从文件读取（Docker/K8s secret 挂载），优先级高于 MGW_SECRET
MGW_SECRET_FILE=
# 管理后台鉴权：Logto OIDC（access token 的 issuer 与 audience）
# issuer 必须与 Logto endpoint 一致，末尾带 /oidc
LOGTO_ISSUER=http://localhost:3001/oidc
# 与 Logto 中「API Resource」的 indicator 完全一致
LOGTO_AUDIENCE=https://api.gateway.local

# ── 出站 SSRF 白名单（逗号分隔 CIDR）──
# 169.254.0.0/16 永久拒绝，无需列出
MGW_OUTBOUND_ALLOWED_CIDRS=10.0.0.0/8,127.0.0.1/32,192.168.0.0/16

# ── 会话 / 上游 ──
MGW_MAX_SESSIONS=300
MGW_SESSION_IDLE_TIMEOUT_S=1800
# stdio 上游子进程上限
MGW_STDIO_MAX=8
# 注册表定时刷新间隔（秒）
MGW_REGISTRY_REFRESH_INTERVAL_S=300

# ── 审计攒批 ──
MGW_AUDIT_FLUSH_MS=1000
MGW_AUDIT_FLUSH_SIZE=100

# ── 告警 ──
# 熔断/上游故障推送的 IM Webhook（企业微信/飞书/Slack 等），留空=不推送
MGW_IM_WEBHOOK=

# ── 运行环境 ──
NODE_ENV=development

# ── 回归脚本机器身份（Logto client_credentials）──
# 管理端只认 Logto JWT，scripts/*.sh 用这对凭据换 token。
# 由 auth-platform/scripts/provision.mjs 创建「MCP 网关冒烟客户端」后填入，仅本地/CI 使用。
MGW_M2M_CLIENT_ID=
MGW_M2M_CLIENT_SECRET=
MGW_LOGTO_ENDPOINT=http://localhost:3001
