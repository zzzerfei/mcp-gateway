{
	admin off
}

# ── 管理后台 + MCP 通道 ───────────────────────────────
# SITE_ADDRESS 写域名（如 mcp.1-2-3-4.sslip.io）时，Caddy 自动申请并续期证书；
# 写 :80 则是纯 HTTP（此时 Logto 登录不可用，只能看登录页）。
{$SITE_ADDRESS::80} {
	encode gzip zstd

	# 管理端 API、MCP 通道、探活统一走后端；/metrics 不对外暴露
	@backend path /admin/api/* /mcp /mcp/* /healthz
	handle @backend {
		reverse_proxy gateway:8080 {
			# SSE（GET /mcp）需要立即 flush，不能缓冲
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# 带 hash 的静态资源长缓存，index.html 不缓存
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# ── Logto（auth-platform，容器在另一份 compose 里）──
# Logto 的登录页/管理台依赖 Web Crypto，必须是 HTTPS，故同样由这台 Caddy 按域名反代。
# 走 host.docker.internal 访问宿主机上 auth-platform 发布的端口，避免跨 compose 组网。
# 注意：Logto 在宿主机上映射到 13001（OIDC）/ 13002（Admin），与 3001 上其他服务错开。
{$AUTH_SITE_ADDRESS:auth.localhost} {
	reverse_proxy host.docker.internal:13001
	header {
		-Server
		X-Content-Type-Options nosniff
	}
}

{$AUTH_ADMIN_SITE_ADDRESS:admin.localhost} {
	reverse_proxy host.docker.internal:13002
	header {
		-Server
		X-Content-Type-Options nosniff
	}
}
