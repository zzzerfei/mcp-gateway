{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "MCP 网关运行态概览 · P1-G 交付看板 · 对应 /metrics.prom 端点。含 HTTP 入口 QPS/延时/错误、上游 tool_call 分布、熔断状态、事件循环延迟、进程内存。",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "HTTP QPS",
      "description": "5m 平均每秒进入网关的请求数（含 MCP/Admin），已排除 /metrics /healthz 自反馈",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "amber", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mgw_http_requests_total[5m]))",
          "legendFormat": "QPS"
        }
      ]
    },
    {
      "type": "stat",
      "title": "HTTP P95 延时",
      "description": "全路由聚合的 95 分位响应时间（ms）。PRD 8.1 目标：网关自身 < 10ms。",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "amber", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mgw_http_request_duration_ms_bucket[5m])))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "type": "stat",
      "title": "HTTP 错误率",
      "description": "5xx / (2xx+4xx+5xx)。4xx 通常是鉴权/参数问题，不计入错误率。",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "amber", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mgw_http_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(mgw_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "type": "stat",
      "title": "熔断中上游",
      "description": "当前处于 open 状态的上游数量。>0 表示有工具暂不可用；面板顶部会同步显示",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(mgw_upstream_breaker_state == 2) or vector(0)",
          "legendFormat": "open"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP QPS by route",
      "description": "按归一化路由模板分组的请求速率。__unmatched__ 增长说明有扫描/前端路径错误",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "lineWidth": 1, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (route) (rate(mgw_http_requests_total[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP 延时分布",
      "description": "P50 / P95 / P99 全路由聚合。P99 突增通常对应上游回源变慢或 GC 抖动",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mgw_http_request_duration_ms_bucket[5m])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mgw_http_request_duration_ms_bucket[5m])))",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mgw_http_request_duration_ms_bucket[5m])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "MCP tool_call by upstream",
      "description": "上游维度的 tool 调用速率。err 状态含熔断快速失败",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 25 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (upstream, status) (rate(mgw_tool_calls_total[5m]))",
          "legendFormat": "{{upstream}} · {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "熔断状态时间线",
      "description": "每个上游的三态：0=closed · 1=half-open · 2=open。红色台阶即熔断窗口",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 20 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mgw_upstream_breaker_state",
          "legendFormat": "{{upstream}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "事件循环延迟 (P99)",
      "description": "Node.js 事件循环 lag。PRD 8.1：P99 > 200ms 触发 IM 告警",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 20, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mgw_nodejs_eventloop_lag_seconds_bucket[2m])))",
          "legendFormat": "P99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mgw_nodejs_eventloop_lag_seconds_bucket[2m])))",
          "legendFormat": "P50"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "进程内存 (RSS)",
      "description": "Node.js 常驻内存。突增通常与审计队列、注册表规模相关",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 15 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mgw_process_resident_memory_bytes",
          "legendFormat": "RSS"
        },
        {
          "refId": "B",
          "expr": "mgw_nodejs_heap_size_used_bytes",
          "legendFormat": "Heap used"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "运行态 gauge（拉取前刷新）",
      "description": "会话 / 已连上游 / 注册表工具数 / 审计队列深度 / 令牌桶数量。由 refreshRuntime() 在 controller 输出前刷新",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 8 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "refId": "A", "expr": "mgw_sessions_active", "legendFormat": "会话数" },
        { "refId": "B", "expr": "mgw_upstreams_connected", "legendFormat": "已连上游" },
        { "refId": "C", "expr": "mgw_registry_tools_total", "legendFormat": "注册工具" },
        { "refId": "D", "expr": "mgw_audit_queue_depth", "legendFormat": "审计队列" },
        { "refId": "E", "expr": "mgw_ratelimit_buckets", "legendFormat": "令牌桶数" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["mcp-gateway", "mgw", "p1"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "MCP Gateway · 运行概览",
  "uid": "mgw-overview",
  "version": 1,
  "weekStart": ""
}
