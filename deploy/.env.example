# 生产环境变量模板：复制为 deploy/.env 后逐项填值（.env 已被 .gitignore 排除）
#   cd deploy && cp .env.example .env
#
# 下面用 1-2-3-4 代表服务器 IP（点换成横线）。sslip.io 是免费通配 DNS：
# 任何 IP 都自带 <ip-dashes>.sslip.io 域名且自动解析到该 IP，无需买域名、无需配 DNS。
# 例：服务器 47.98.12.34 → mcp.47-98-12-34.sslip.io
#
# 为什么必须走 HTTPS：Logto 的登录页与 Admin Console 依赖浏览器 Web Crypto，
# 只在「HTTPS 或 http://localhost」下可用，用 http://IP 点登录会直接失败。
#
# 前置条件：服务器 80/443 对公网开放（Caddy 用 80 做 ACME 校验、443 提供服务），
# sslip.io 域名会解析到服务器 IP，Caddy 自动签发并续期 Let's Encrypt 证书。

# ── 对外访问 ──────────────────────────────────────────
SITE_ADDRESS=mcp.1-2-3-4.sslip.io
AUTH_SITE_ADDRESS=auth.1-2-3-4.sslip.io
AUTH_ADMIN_SITE_ADDRESS=admin.1-2-3-4.sslip.io
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=latest

# 浏览器访问管理与 MCP 的地址（与 SITE_ADDRESS 保持一致）
MGW_PUBLIC_ORIGIN=https://mcp.1-2-3-4.sslip.io
MGW_ALLOWED_ORIGINS=https://mcp.1-2-3-4.sslip.io

# ── 前端构建期参数（改了必须重新 build）──────────────
# app id 由 auth-platform 的 provision.mjs 在新环境创建后给出
VITE_LOGTO_ENDPOINT=https://auth.1-2-3-4.sslip.io
VITE_LOGTO_APP_ID=
VITE_LOGTO_AUDIENCE=https://api.gateway.local

# ── 网关运行时 ────────────────────────────────────────
NODE_ENV=production
MGW_PORT=8080
MGW_HOST=0.0.0.0
MGW_DATA_DIR=/app/data

# 主密钥：openssl rand -hex 32；缺失时生产环境拒绝启动
MGW_SECRET=

# 必须与 Logto 的 ENDPOINT 同源，否则 token 验签失败
LOGTO_ISSUER=https://auth.1-2-3-4.sslip.io/oidc
LOGTO_AUDIENCE=https://api.gateway.local

# 出站白名单：只放开上游实际所在的网段（默认拒绝所有）
MGW_OUTBOUND_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16

# 可选
MGW_MAX_SESSIONS=300
MGW_SESSION_IDLE_TIMEOUT_S=1800
MGW_IM_WEBHOOK=
