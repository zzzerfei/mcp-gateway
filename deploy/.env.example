# 生产环境变量模板：复制为 deploy/.env 后逐项填值（.env 已被 .gitignore 排除）
#   cd deploy && cp .env.example .env
#
# 注意（先读）：Logto 管理台与 SPA 登录依赖 Web Crypto，浏览器只在
# 「HTTPS 或 http://localhost」下提供 crypto.subtle。用 http://IP 访问时登录会失败，
# 届时把 SITE_ADDRESS 换成域名（如 1-2-3-4.sslip.io）即可自动申请证书。

# ── 对外访问 ──────────────────────────────────────────
# 纯 HTTP：SITE_ADDRESS=:80，管理台 http://<服务器IP>:<HTTP_PORT>
# 有域名：SITE_ADDRESS=mcp.example.com 且 HTTP_PORT 改回 80（Caddy 用 80 做 ACME 校验，自动签发/续期）
SITE_ADDRESS=:80
HTTP_PORT=8088
HTTPS_PORT=443
IMAGE_TAG=latest

# 浏览器访问管理与 MCP 的地址（与 SITE_ADDRESS/HTTP_PORT 对应）
MGW_PUBLIC_ORIGIN=http://SERVER_IP:8088
MGW_ALLOWED_ORIGINS=http://SERVER_IP:8088

# ── 前端构建期参数（改了必须重新 build）──────────────
# app id 由 auth-platform 的 provision.mjs 在新环境创建后给出
VITE_LOGTO_ENDPOINT=http://SERVER_IP:3001
VITE_LOGTO_APP_ID=
VITE_LOGTO_AUDIENCE=https://api.gateway.local

# ── 网关运行时 ────────────────────────────────────────
NODE_ENV=production
MGW_PORT=8080
MGW_HOST=0.0.0.0
MGW_DATA_DIR=/app/data

# 主密钥：openssl rand -hex 32；缺失时生产环境拒绝启动
MGW_SECRET=

LOGTO_ISSUER=http://SERVER_IP:3001/oidc
LOGTO_AUDIENCE=https://api.gateway.local

# 出站白名单：只放开上游实际所在的网段（默认拒绝所有）
MGW_OUTBOUND_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16

# 可选
MGW_MAX_SESSIONS=300
MGW_SESSION_IDLE_TIMEOUT_S=1800
MGW_IM_WEBHOOK=
