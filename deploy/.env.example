# ---- 必填 ----
# 上游凭据加密主密钥：openssl rand -hex 32
MGW_SECRET=
# 管理后台登录令牌：openssl rand -hex 24
ADMIN_TOKEN=

# ---- 访问地址 ----
# 对外访问地址，例如 http://1.2.3.4 或 https://mcp.example.com
MGW_PUBLIC_ORIGIN=http://YOUR_SERVER_IP
# 额外允许的浏览器来源，逗号分隔；留空表示反射任意 Origin
MGW_ALLOWED_ORIGINS=

# ---- 运行参数 ----
# 出站 CIDR 白名单；留空使用默认内网白名单（只接 stdio 上游时无需修改）
MGW_OUTBOUND_ALLOWED_CIDRS=
MGW_MAX_SESSIONS=300
MGW_SESSION_IDLE_TIMEOUT_S=1800
MGW_DB_SYNCHRONIZE=1
